# THLA MES Backend - MẪU biến môi trường (file này commit lên git, KHÔNG để giá trị thật).
# Cách dùng: copy thành .env rồi điền giá trị thật. File .env đã được gitignore.
NODE_ENV=development
PORT=5002

# PostgreSQL
PGHOST=your_db_host
PGPORT=5432
PGDATABASE=your_db_name
PGUSER=your_db_user
PGPASSWORD=your_db_password
PGSSL=false

# JWT — đặt chuỗi ngẫu nhiên đủ dài, BẢO MẬT (đừng commit giá trị thật).
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES=365d

# CORS (frontend origin)
CORS_ORIGIN=https://your-frontend-domain

# ERP — URL API lấy phiếu nhận vải (PHẢI là URL đầy đủ kèm path; code chỉ nối thêm ?fromDate=).
# Mỗi môi trường giữ .env riêng (file .env đã gitignore) nên upload code KHÔNG ghi đè:
#   - LOCAL / trong mạng LAN  : http://10.84.40.34:5000/api/server/backup/mes/phieu-nhan-vai-60
#   - SERVER public           : http://118.69.134.179:5000/api/server/backup/mes/phieu-nhan-vai-60
ERP_PHIEU_NHAN_VAI_URL=http://<erp-host>:5000/api/server/backup/mes/phieu-nhan-vai-60

# ERP — URL API lấy MÃ TEM 15 (barcode 12 số, 2 số đầu = tiền tố công đoạn 15). CÙNG HOST với URL trên.
# ⚠⚠ ĐẶT BIẾN NÀY Ở MỌI MÔI TRƯỜNG, giống hệt ERP_PHIEU_NHAN_VAI_URL — thiếu nó là KHÔNG IN ĐƯỢC TEM
#    (lỗi thật 2026-08-11: production chỉ đặt URL nhận vải nên đồng bộ vẫn chạy ngon, còn lấy mã tem
#     gọi nhầm địa chỉ → timeout → chặn in, mà log đồng bộ vẫn xanh nên rất khó đoán ra).
# ⚠⚠ ERP ĐỔI TÊN ENDPOINT: `/barcode-tem` → `/barcode-tem-15` (16/09/2026) cho đồng bộ với -17/-13.
#    Tên biến MỚI là ERP_BARCODE_TEM_15_URL; tên CŨ ERP_BARCODE_TEM_URL vẫn được đọc (ưu tiên tên mới)
#    để môi trường chưa kịp sửa `.env` không chết. ⚠ Nhưng biến cũ trỏ `/barcode-tem` thì PHẢI sửa đuôi
#    thành `-15`, vì biến tường minh luôn THẮNG giá trị mặc định của code.
#   - LOCAL / trong mạng LAN  : http://10.84.40.34:5000/api/server/backup/mes/barcode-tem-15
#   - SERVER public           : http://118.69.134.179:5000/api/server/backup/mes/barcode-tem-15
ERP_BARCODE_TEM_15_URL=http://<erp-host>:5000/api/server/backup/mes/barcode-tem-15
# (Tùy chọn) ERP_BARCODE_TEM_TIMEOUT_MS=10000  # người đứng chờ máy in nên để ngắn
# (Tùy chọn) ERP_BARCODE_TEM_RETRY=3           # hết lượt thì CHẶN in (không lùi về mã TEM… cũ)

# ERP — MÃ TEM RIÊNG CHO 2 CÔNG ĐOẠN (thêm 06/09/2026). CÙNG HOST với URL trên.
# Tem 17 (hàng SỬA ĐẠT) và tem 13 (hàng GIA CÔNG VỀ) nay XIN MÃ RIÊNG thay vì lấy mã tem 15 rồi thay
# 2 số đầu ⇒ ERP phân biệt được từng nhãn giấy. Liên kết "tem 17 là hàng sửa đạt của tem 15 nào" do
# cột `tem.tem_goc_id` (mig 091) gánh, không còn nằm trong chuỗi mã.
# ⚠ Dùng chung ERP_BARCODE_TEM_TIMEOUT_MS / _RETRY với API mã tem 15 ở trên.
# ⚠ Thiếu biến ⇒ suy theo gốc URL nhận vải (có cảnh báo lúc khởi động); tắt hẳn được ở
#   *Hệ thống > Cài đặt API* (khi đó lùi về cách cũ: suy mã từ tem 15).
#   - LOCAL / trong mạng LAN  : http://10.84.40.34:5000/api/server/backup/mes/barcode-tem-17
#   - SERVER public           : http://118.69.134.179:5000/api/server/backup/mes/barcode-tem-17
ERP_BARCODE_TEM_17_URL=http://<erp-host>:5000/api/server/backup/mes/barcode-tem-17
ERP_BARCODE_TEM_13_URL=http://<erp-host>:5000/api/server/backup/mes/barcode-tem-13

# ERP — URL API BÁO NGƯỢC mỗi lần in tem (proc MES_spr_MES2SF0). CÙNG HOST với 2 URL trên.
# Đây là chiều ĐẨY duy nhất của hệ: MES báo lên ERP "đã in tem gì, ai in, lúc nào, SL bao nhiêu".
# ⚠ Khác 2 API trên: gọi NGẦM sau khi tem ĐÃ tạo ⇒ lỗi thì ghi log rồi thôi, KHÔNG chặn in
#   (lúc đó mã tem đã tiêu của ERP, chặn lại là hỏng việc của người đứng máy).
#   - LOCAL \ trong mạng LAN  : http://10.84.40.34:5000/api/server/backup/mes/ghi-in-tem
#   - SERVER public           : http://118.69.134.179:5000/api/server/backup/mes/ghi-in-tem
ERP_GHI_IN_TEM_URL=http://<erp-host>:5000/api/server/backup/mes/ghi-in-tem
ERP_GHI_IN_TEM_ENABLED=true                   # MẶC ĐỊNH ban đầu — xem ghi chú "công tắc" bên dưới
# (Tùy chọn) ERP_GHI_IN_TEM_TIMEOUT_MS=10000
# (Tùy chọn) ERP_GHI_IN_TEM_RETRY=3           # hết lượt thì ghi audit_log ERP_GHI_IN_TEM_LOI

# ERP — 3 API PHIẾU GIAO / PHÂN LOẠI LỖI (thêm 04/09/2026). CÙNG HOST với các URL trên.
#   - LOCAL \ trong mạng LAN  : http://10.84.40.34:5000/api/server/backup/mes/<đường dẫn>
#   - SERVER public           : http://118.69.134.179:5000/api/server/backup/mes/<đường dẫn>
# ⚠ Bỏ trống thì tự suy theo GỐC của ERP_PHIEU_NHAN_VAI_URL — vẫn nên đặt tường minh ở production.
# 1) Xin số phiếu giao do ERP cấp. ⚠ Mỗi lần gọi TIÊU MỘT SỐ (giống barcode-tem).
#    Lỗi ⇒ MES lùi về mã phiếu tự sinh, KHÔNG chặn việc giao hàng.
ERP_LAY_ID_PHIEU_GIAO_URL=http://<erp-host>:5000/api/server/backup/mes/lay-id-phieu-giao
# (Tùy chọn) ERP_LAY_ID_PHIEU_GIAO_TIMEOUT_MS=10000
# (Tùy chọn) ERP_LAY_ID_PHIEU_GIAO_RETRY=3
# 2) Đẩy nội dung phiếu giao sang ERP — chạy NGẦM, lỗi thì ghi log rồi thôi.
ERP_GUI_PHIEU_GIAO_URL=http://<erp-host>:5000/api/server/backup/mes/gui-erp-phieu-giao
ERP_GUI_PHIEU_GIAO_ENABLED=true               # MẶC ĐỊNH ban đầu — xem ghi chú "công tắc" bên dưới
# (Tùy chọn) ERP_GUI_PHIEU_GIAO_TIMEOUT_MS=10000
# (Tùy chọn) ERP_GUI_PHIEU_GIAO_RETRY=3
# 3) Đẩy phiếu phân loại lỗi sang ERP — chạy NGẦM, lỗi thì ghi log rồi thôi.
ERP_GUI_PHAN_LOAI_LOI_URL=http://<erp-host>:5000/api/server/backup/mes/gui-erp-phan-loai-loi
ERP_GUI_PHAN_LOAI_LOI_ENABLED=true            # MẶC ĐỊNH ban đầu
# (Tùy chọn) ERP_GUI_PHAN_LOAI_LOI_TIMEOUT_MS=10000
# (Tùy chọn) ERP_GUI_PHAN_LOAI_LOI_RETRY=3
# 4) Đẩy SỬA ĐẠT (tem 17) sang ERP — proc MES_spr_MES2SK6, cùng 20 tham số với ghi-in-tem (21/09/2026).
#    Gửi ĐÚNG 1 LẦN mỗi lượt sửa đạt, chạy NGẦM; lỗi thì bấm "Gửi lại ERP" ở sidebar Đã hoàn thành màn Sửa.
ERP_GUI_SUA_DAT_URL=http://<erp-host>:5000/api/server/backup/mes/gui-erp-sua-dat
ERP_GUI_SUA_DAT_ENABLED=true                  # MẶC ĐỊNH ban đầu
# (Tùy chọn) ERP_GUI_SUA_DAT_TIMEOUT_MS=10000
# (Tùy chọn) ERP_GUI_SUA_DAT_RETRY=3
# 5) Đẩy KẾT QUẢ KIỂM KCS (kiểm phẩm) sang ERP lúc xác nhận KCS (24/09/2026) — chạy NGẦM, 1 lần/lượt kiểm.
ERP_GUI_KIEM_PHAM_URL=http://<erp-host>:5000/api/server/backup/mes/gui-erp-kiem-pham
ERP_GUI_KIEM_PHAM_ENABLED=true                # MẶC ĐỊNH ban đầu
# (Tùy chọn) ERP_GUI_KIEM_PHAM_TIMEOUT_MS=10000
# (Tùy chọn) ERP_GUI_KIEM_PHAM_RETRY=3
# Kéo phần in GN đã sửa thông tin bên ERP (job 5 phút/lần, trang "Phần in chờ sửa thông tin")
ERP_DS_PHAN_IN_SUA_THONG_TIN_URL=http://<erp-host>:5000/api/server/backup/mes/ds-phan-in-sua-thong-tin
ERP_DS_PHAN_IN_SUA_THONG_TIN_ENABLED=true     # MẶC ĐỊNH ban đầu

# ─── BẬT / TẮT API — LÀM Ở GIAO DIỆN, KHÔNG PHẢI Ở ĐÂY (mig 083) ────────────────────────────
# Trang **Hệ thống > Cài đặt API** bật/tắt 6 API ERP và có hiệu lực NGAY, khỏi sửa file + restart.
#   · Lấy mã tem        → tắt thì MES tự sinh mã TEM00123 (⚠ máy quét bên ERP không đọc được)
#   · Báo ERP in tem    → tắt thì bỏ qua, không ảnh hưởng việc in
#   · Đồng bộ đợt vải   → tắt thì job bỏ lượt chạy + nút "Đồng bộ ngay" cũng báo đang tắt
#   · Lấy ID phiếu giao → tắt thì MES tự sinh mã phiếu giao (ERP không đối soát theo số này được)
#   · Gửi phiếu giao    → tắt thì bỏ qua, không ảnh hưởng việc xác nhận giao
#   · Gửi phân loại lỗi → tắt thì bỏ qua, không ảnh hưởng việc lưu phiếu
#
# ⚠ VÌ THẾ 2 BIẾN `*_ENABLED` DƯỚI ĐÂY CHỈ CÒN LÀ **GIÁ TRỊ MẶC ĐỊNH BAN ĐẦU** — dùng khi bảng
#   `cai_dat_api` chưa có dòng cho API đó (chưa ai đụng trang cài đặt / chưa chạy mig 083).
#   Đã bật/tắt trên giao diện rồi thì **giá trị trong DB THẮNG**, sửa ở đây không có tác dụng.
# ⚠ API "Lấy mã tem" CỐ Ý KHÔNG có biến `.env` — mặc định luôn BẬT, chỉ tắt được ở giao diện
#   (tắt là tem không quét được bên ERP nên phải có người bấm + ghi lý do, không để lặng lẽ qua file).

# (Tùy chọn) ERP nâng cao:
# Job tự đồng bộ ERP theo chu kỳ: đặt =false ở LOCAL để KHÔNG chạy khi npm; =true (hoặc bỏ trống, mặc định true) ở SERVER.
ERP_SYNC_ENABLED=false           # LOCAL: false · SERVER (.env riêng): true
# ERP_SYNC_INTERVAL_MIN=5          # chu kỳ (phút) — mặc định 5 phút/lần (sàn tối thiểu 5)
# ERP_SYNC_TIMEOUT_MS=600000       # timeout chờ ERP (ms)
# ERP_PROXY_URL=http://host:port   # chỉ định proxy nếu cần ra mạng nội bộ (thường KHÔNG cần)

# (Tùy chọn) Upload/avatar:
# UPLOAD_ROOT=D:/uploads
# PUBLIC_BASE_URL=https://api.thuanhunglongan.com

# ─── WEB PUSH (thông báo cả khi ĐÓNG app) — mig 085 ───────────────────────────
# ⚠⚠ MỖI MÔI TRƯỜNG PHẢI TỰ SINH CẶP KHÓA RIÊNG, KHÔNG dùng chung, KHÔNG commit khóa thật:
#     npx web-push generate-vapid-keys
# Thiếu 2 khóa này ⇒ Web Push TỰ TẮT (log 1 dòng lúc khởi động), chuông + popup khi app đang mở
# vẫn chạy bình thường. Bật/tắt push nền làm ở *Hệ thống > Cài đặt thông báo* (cờ PUSH_NEN).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Bắt buộc theo chuẩn Web Push: mailto: hoặc https: — nơi dịch vụ push liên hệ khi có sự cố.
VAPID_SUBJECT=mailto:admin@thuanhunglongan.com
