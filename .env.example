# THLA MES Backend - MẪU biến môi trường (file này commit lên git, KHÔNG để giá trị thật).
# Cách dùng: copy thành .env rồi điền giá trị thật. File .env đã được gitignore.
NODE_ENV=development
PORT=5002

# PostgreSQL
PGHOST=your_db_host
PGPORT=5432
PGDATABASE=your_db_name
PGUSER=your_db_user
PGPASSWORD=your_db_password
PGSSL=false

# JWT — đặt chuỗi ngẫu nhiên đủ dài, BẢO MẬT (đừng commit giá trị thật).
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES=365d

# CORS (frontend origin)
CORS_ORIGIN=https://your-frontend-domain

# ERP — URL API lấy phiếu nhận vải (PHẢI là URL đầy đủ kèm path; code chỉ nối thêm ?fromDate=).
# Mỗi môi trường giữ .env riêng (file .env đã gitignore) nên upload code KHÔNG ghi đè:
#   - LOCAL / trong mạng LAN  : http://10.84.40.34:5000/api/server/backup/mes/phieu-nhan-vai-60
#   - SERVER public           : http://118.69.134.179:5000/api/server/backup/mes/phieu-nhan-vai-60
ERP_PHIEU_NHAN_VAI_URL=http://<erp-host>:5000/api/server/backup/mes/phieu-nhan-vai-60

# ERP — URL API lấy MÃ TEM (barcode 12 số, 2 số đầu = tiền tố công đoạn 15). CÙNG HOST với URL trên.
# ⚠⚠ ĐẶT BIẾN NÀY Ở MỌI MÔI TRƯỜNG, giống hệt ERP_PHIEU_NHAN_VAI_URL — thiếu nó là KHÔNG IN ĐƯỢC TEM
#    (lỗi thật 2026-08-11: production chỉ đặt URL nhận vải nên đồng bộ vẫn chạy ngon, còn lấy mã tem
#     gọi nhầm địa chỉ → timeout → chặn in, mà log đồng bộ vẫn xanh nên rất khó đoán ra).
#   - LOCAL / trong mạng LAN  : http://10.84.40.34:5000/api/server/backup/mes/barcode-tem
#   - SERVER public           : http://118.69.134.179:5000/api/server/backup/mes/barcode-tem
ERP_BARCODE_TEM_URL=http://<erp-host>:5000/api/server/backup/mes/barcode-tem
# (Tùy chọn) ERP_BARCODE_TEM_TIMEOUT_MS=10000  # người đứng chờ máy in nên để ngắn
# (Tùy chọn) ERP_BARCODE_TEM_RETRY=3           # hết lượt thì CHẶN in (không lùi về mã TEM… cũ)

# ERP — URL API BÁO NGƯỢC mỗi lần in tem (proc MES_spr_MES2SF0). CÙNG HOST với 2 URL trên.
# Đây là chiều ĐẨY duy nhất của hệ: MES báo lên ERP "đã in tem gì, ai in, lúc nào, SL bao nhiêu".
# ⚠ Khác 2 API trên: gọi NGẦM sau khi tem ĐÃ tạo ⇒ lỗi thì ghi log rồi thôi, KHÔNG chặn in
#   (lúc đó mã tem đã tiêu của ERP, chặn lại là hỏng việc của người đứng máy).
#   - LOCAL \ trong mạng LAN  : http://10.84.40.34:5000/api/server/backup/mes/ghi-in-tem
#   - SERVER public           : http://118.69.134.179:5000/api/server/backup/mes/ghi-in-tem
ERP_GHI_IN_TEM_URL=http://<erp-host>:5000/api/server/backup/mes/ghi-in-tem
ERP_GHI_IN_TEM_ENABLED=true                   # MẶC ĐỊNH ban đầu — xem ghi chú "công tắc" bên dưới
# (Tùy chọn) ERP_GHI_IN_TEM_TIMEOUT_MS=10000
# (Tùy chọn) ERP_GHI_IN_TEM_RETRY=3           # hết lượt thì ghi audit_log ERP_GHI_IN_TEM_LOI

# ─── BẬT / TẮT API — LÀM Ở GIAO DIỆN, KHÔNG PHẢI Ở ĐÂY (mig 083) ────────────────────────────
# Trang **Hệ thống > Cài đặt API** bật/tắt 3 API ERP và có hiệu lực NGAY, khỏi sửa file + restart.
#   · Lấy mã tem      → tắt thì MES tự sinh mã TEM00123 (⚠ máy quét bên ERP không đọc được)
#   · Báo ERP in tem  → tắt thì bỏ qua, không ảnh hưởng việc in
#   · Đồng bộ đợt vải → tắt thì job bỏ lượt chạy + nút "Đồng bộ ngay" cũng báo đang tắt
#
# ⚠ VÌ THẾ 2 BIẾN `*_ENABLED` DƯỚI ĐÂY CHỈ CÒN LÀ **GIÁ TRỊ MẶC ĐỊNH BAN ĐẦU** — dùng khi bảng
#   `cai_dat_api` chưa có dòng cho API đó (chưa ai đụng trang cài đặt / chưa chạy mig 083).
#   Đã bật/tắt trên giao diện rồi thì **giá trị trong DB THẮNG**, sửa ở đây không có tác dụng.
# ⚠ API "Lấy mã tem" CỐ Ý KHÔNG có biến `.env` — mặc định luôn BẬT, chỉ tắt được ở giao diện
#   (tắt là tem không quét được bên ERP nên phải có người bấm + ghi lý do, không để lặng lẽ qua file).

# (Tùy chọn) ERP nâng cao:
# Job tự đồng bộ ERP theo chu kỳ: đặt =false ở LOCAL để KHÔNG chạy khi npm; =true (hoặc bỏ trống, mặc định true) ở SERVER.
ERP_SYNC_ENABLED=false           # LOCAL: false · SERVER (.env riêng): true
# ERP_SYNC_INTERVAL_MIN=5          # chu kỳ (phút) — mặc định 5 phút/lần (sàn tối thiểu 5)
# ERP_SYNC_TIMEOUT_MS=600000       # timeout chờ ERP (ms)
# ERP_PROXY_URL=http://host:port   # chỉ định proxy nếu cần ra mạng nội bộ (thường KHÔNG cần)

# (Tùy chọn) Upload/avatar:
# UPLOAD_ROOT=D:/uploads
# PUBLIC_BASE_URL=https://api.thuanhunglongan.com
